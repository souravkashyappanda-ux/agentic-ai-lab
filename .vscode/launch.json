{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Database registry check (no Claude)",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.check_database_tool",
            "args": ["PO-1001"],
            "stopOnEntry": true,
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Registry override test (offline)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/unit/test_tool_registry.py::test_custom_function_mapping",
                "-v",
                "-s",
                "-p",
                "no:cacheprovider"
            ],
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Full agent (paid Claude API)",
            "type": "debugpy",
            "request": "launch",
            "module": "po_agent",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
